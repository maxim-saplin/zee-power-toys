<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:sharedUserId="android.uid.system">

    <!-- Boot auto-launch (Block 0010) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Foreground service (mandatory for startForegroundService) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Forward-compat: required by API 34+ for dataSync FGS type.
         Harmless on API 32 (our emulator target). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Internet — required to download APKs from GitHub releases (Block 0014). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Allow installing APKs downloaded from GitHub (Block 0014).
         On API 26+ the user must also grant "Install unknown apps" per-source
         in Settings for the first install; subsequent installs from the same
         source are remembered.  On emulators without this setting the system
         will show the dialog; the download itself always completes. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- YNavi CarApp host permissions (Block YNavi / YNaviCarAppHost).
         TEMPLATE_RENDERER: system/signature permission pre-granted on Zeekr OS;
         required to bind the CarApp cluster host.  Declaring it here is harmless
         on stock Android where it is not enforced.
         NAVIGATION_TEMPLATES: required by the AndroidX Car App library when the host
         connects to a navigation CarApp service. -->
    <uses-permission android:name="android.car.permission.TEMPLATE_RENDERER" />
    <uses-permission android:name="androidx.car.app.NAVIGATION_TEMPLATES" />

    <application
        android:label="zee_power_toys"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Native CarSignals broadcast receivers (ADR 0004 native channel).
             SIMULATE: inject simulated car signals via ADB broadcast.
             DUMP:     return current signal state as JSON in result data (ordered broadcast).
             Both exported=true so ADB (shell uid) can broadcast to them. -->
        <receiver
            android:name=".carsignals.SimulateReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.zeepowertoys.SIMULATE"/>
            </intent-filter>
            <intent-filter>
                <action android:name="com.zeepowertoys.DUMP"/>
            </intent-filter>
        </receiver>

        <!-- Boot receiver — fires after credential unlock (directBootAware=false).
             Starts ZeeForegroundService which is the background keepalive.
             Block 0010 / ADR 0003: BootReceiver reads config via ConfigShim
             before any Flutter isolate exists. -->
        <receiver
            android:name=".boot.BootReceiver"
            android:exported="true"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- QUICKBOOT_POWERON: some OEM (HTC/Xiaomi) fast-boot variant -->
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
            <!-- TEST_BOOT: non-protected alias used in smoke tests / T2 emulator.
                 Production-build emulators block BOOT_COMPLETED from adb shell;
                 this action exercises the same code path without that restriction. -->
            <intent-filter>
                <action android:name="com.zeepowertoys.TEST_BOOT" />
            </intent-filter>
        </receiver>

        <!-- Background keepalive foreground service (Block 0010).
             foregroundServiceType="dataSync" declared for API 34+ forward compat.
             On API 32 the type attribute is accepted but the type permission is
             not enforced. No wake locks; no GPS/camera/mic — dataSync is the
             appropriate catch-all for a background-keepalive-only service. -->
        <service
            android:name=".boot.ZeeForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- FileProvider — exposes APK files from app cache to the system
             installer via a content:// URI (used by the AppInstaller fallback
             intent path in Block 0014).  authorities must match the string
             used in FileProvider.getUriForFile() in AppInstaller.kt. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- YNavi mod detection: allows PackageManager.getPackageInfo() and
             bindService() to resolve ru.yandex.yandexnavi on API 30+.
             Without this entry, the package is invisible to non-system apps. -->
        <package android:name="ru.yandex.yandexnavi" />
    </queries>
</manifest>
